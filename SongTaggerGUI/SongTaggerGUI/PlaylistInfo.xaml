<Window x:Class="SongTaggerGUI.PlaylistInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SongTaggerGUI"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="PlaylistInfo" Height="450" Width="500
        ">
    <Grid>
        <TextBlock x:Name="TitleText" HorizontalAlignment="Left" Height="24" Margin="28,10,0,0" TextWrapping="Wrap" Text="Playlist Fetched!" VerticalAlignment="Top" Width="208" FontWeight="Bold" />
        <DataGrid x:Name="songDataGrid"
          Margin="24,56,25,99"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          SelectionMode="Extended"
          FrozenColumnCount="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding title}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Artist" Binding="{Binding artists}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Album" Binding="{Binding album}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Continue" HorizontalAlignment="Left" Height="34" Margin="156,362,0,0" VerticalAlignment="Top" Width="161" Click="Button_Click"/>
    </Grid>
</Window>
