<Window x:Class="SongTaggerGUI.SpotiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SongTaggerGUI"
        mc:Ignorable="d"
        Title="SpotiWindow" Height="443" Width="668">
    <Grid>
        <TextBox x:Name="urlBox"  HorizontalAlignment="Left" Height="29" Margin="29,67,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="504"/>
        <Button x:Name="dirButton" Content="Select a Directory" HorizontalAlignment="Left" Height="40" Margin="29,341,0,0" VerticalAlignment="Top" Width="138" Click="dirButton_Click"/>
        <Label Content="Playlist URL" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" Width="85" Margin="29,37,0,0" RenderTransformOrigin="0.501,0.338"/>
        <Button x:Name="makeButton" Content="Make File" HorizontalAlignment="Left" Height="40" Margin="236,341,0,0" VerticalAlignment="Top" Width="145" Click="makeFile"/>

        <DataGrid x:Name="songDataGrid"
          Margin="29,172,20,110"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          SelectionMode="Extended"
          FrozenColumnCount="1">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Selected">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding isSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="120" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Fetch Playlist" HorizontalAlignment="Left" Height="36" Margin="29,114,0,0" VerticalAlignment="Top" Width="110" Click="fetchButtonClicked"/>
        <Grid x:Name="LoadingOverlay" Background="#AF000000" Visibility="Collapsed" >
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="165" Height="20" BorderBrush="White" Background="#AFE8E8E8"/>
                <TextBlock Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0" Width="69"><Run Text="Loading..."/><LineBreak/><Run/></TextBlock>
            </StackPanel>
            <TextBox x:Name="LoadingCurrentFileTxt" IsReadOnly ="True" HorizontalAlignment="Center" Height="20" Margin="0,287,0,0" TextWrapping="Wrap" Text="Current File: X" VerticalAlignment="Top" Width="523" Background="#FF707070" Foreground="White" TextAlignment="Center"/>
        </Grid>
    </Grid>

</Window>
